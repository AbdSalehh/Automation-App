    "ably": "^2.22.1",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspreadsheet-ce": "^5.0.4",
