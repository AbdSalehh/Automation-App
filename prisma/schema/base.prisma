generator client {
    provider      = "prisma-client-js"
    output        = "../lib/generated/prisma"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
    id            String    @id @default(uuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?

    /// "user" | "admin"  — minimal RBAC as described in docs/n8n.md.
    role     String  @default("user")
    isActive Boolean @default(true)

    /// Dikunci otomatis setelah gagal login credential beruntun; admin bisa membuka.
    isLocked Boolean @default(false)

    /// "pending" | "approved" | "rejected". Default approved agar akun lama &
    /// akun credential buatan admin bisa langsung login. User Google baru = pending.
    approvalStatus String @default("approved")

    /// Password hash for credential-based (admin-created) accounts. Null for OAuth users.
    passwordHash String?

    /// Onboarding completion flag — true after the user finishes the setup form.
    onboardingCompleted Boolean @default(false)

    /// User's stated purpose: "learning" | "personal" | "professional" | "team"
    usagePurpose String?

    /// Company or organisation name (optional, filled during onboarding).
    organisation String?

    createdAt DateTime @default(now())

    /// Aktivitas terakhir pengguna (di-update saat sesi aktif, throttled).
    lastSeenAt DateTime?

    // NextAuth relations
    accounts Account[]
    sessions Session[]

    // Domain relations
    credentials   Credential[]
    workflows     Workflow[]
    userSetting   UserSetting?
    notifications Notification[]
}

/// Preferensi editor per-pengguna (kanvas, tampilan grid, dsb.).
model UserSetting {
    id     String @id @default(uuid())
    userId String @unique

    /// Ukuran font label node di kanvas (px).
    fontSize Int @default(14)

    /// Tampilkan grid latar kanvas.
    showGrid Boolean @default(true)

    /// Ukuran sel grid (px).
    gridSize Int @default(20)

    /// Tempelkan node ke grid saat digeser.
    snapToGrid Boolean @default(false)

    /// Tampilkan minimap navigasi.
    showMinimap Boolean @default(false)

    /// Tampilkan tombol kontrol zoom/fit.
    showControls Boolean @default(true)

    /// Gaya garis koneksi: "bezier" | "smoothstep" | "step" | "straight".
    connectionMode String @default("bezier")

    /// Kecepatan animasi run node (ms per langkah).
    animationSpeed Int @default(400)

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Notifikasi per-pengguna (hasil run workflow, status akun, kredensial, dsb.).
model Notification {
    id     String @id @default(uuid())
    userId String

    /// Jenis notifikasi: "workflow_success" | "workflow_failed" |
    /// "account_approved" | "credential_failed" | "system" | dll.
    type String @default("system")

    title String
    body  String?

    /// Tautan opsional untuk navigasi saat notifikasi diklik.
    link String?

    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isRead])
    @@index([userId, createdAt])
}

/// NextAuth: OAuth account linked to a User (Google, etc.)
model Account {
    id                String  @id @default(uuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

/// NextAuth: database session for an authenticated user.
model Session {
    id           String   @id @default(uuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// NextAuth: email verification / magic-link tokens.
model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Credential {
    id        String   @id @default(uuid())
    userId    String
    /// Connector type (see comments above for valid values)
    type      String
    /// Human-readable label chosen by the user (e.g. "WA Produksi")
    name      String
    /// AES-256-GCM encrypted JSON blob — never returned to the client
    data      String
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Workflow {
    id      String @id @default(uuid())
    /// Display name, also used as the case-number prefix (e.g. "JR-2026-0001")
    name    String
    ownerId String

    /// Serialised JSON array of React Flow nodes (WorkflowNodeData shape)
    nodes String @default("[]")
    /// Serialised JSON array of React Flow edges
    edges String @default("[]")

    /// Auto-incremented on every save — enables lightweight history tracking
    version Int @default(1)

    /// When true the workflow can be triggered automatically
    isPublished Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    executions Execution[]

    @@index([ownerId])
}

model Execution {
    id         String @id @default(uuid())
    workflowId String

    /// "running" | "success" | "failed"
    status    String   @default("running")
    startedAt DateTime @default(now())

    /// Set when status transitions to success/failed
    finishedAt DateTime?

    /// Serialised JSON of the last node's output (or null if failed early)
    result String?

    workflow Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
    nodeLogs NodeLog[]
    logs     Log[]

    @@index([workflowId])
}

model NodeLog {
    id          String @id @default(uuid())
    executionId String
    nodeId      String

    /// "success" | "failed" | "skipped"
    status String

    /// Serialised JSON output of the node (null if node was skipped/errored before producing output)
    output String?

    timestamp DateTime @default(now())

    execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

    @@index([executionId])
}

model Log {
    id          String @id @default(uuid())
    executionId String
    message     String

    /// "info" | "warn" | "error"
    level String @default("info")

    timestamp DateTime @default(now())

    execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

    @@index([executionId])
}

/// Persisted state for a paused workflow execution (Schedule / Wait Reply).
/// Resumed when the due time passes (scheduler) or a matching reply arrives.
model WaitingExecution {
    id          String @id @default(uuid())
    executionId String
    workflowId  String

    /// The node id where execution paused (schedule or wait_reply).
    nodeId String

    /// "schedule" | "wait_reply"
    pauseType String

    /// For wait_reply: the sender/phone key used to match an incoming reply.
    matchKey String?

    /// For schedule: epoch ms when the workflow should resume.
    dueAt BigInt?

    /// "waiting" | "resumed" | "cancelled"
    status String @default("waiting")

    /// Serialised engine state: per-node outputs + the resume cursor index.
    state String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([workflowId, status])
    @@index([matchKey, status])
}

/// State konfirmasi agen chat-action (mis. menunggu jawaban "ya/batal").
/// Disimpan di DB agar agen tetap berfungsi walau Redis tidak tersedia.
model AgentPendingAction {
    id      String @id @default(uuid())
    ownerId String
    /// Identitas pengirim pada channel (mis. chatId Telegram).
    sender  String

    /// Serialised JSON PendingState (type, prompt, workflowId, workflowName).
    payload String

    /// Epoch ms kapan state ini kedaluwarsa dan boleh diabaikan.
    expiresAt BigInt

    createdAt DateTime @default(now())

    @@unique([ownerId, sender])
}
